# Database
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@pgbouncer:5432/music_school_db?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/music_school_db

# JWT
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Admin default credentials (change after first login)
ADMIN_EMAIL=admin@musicschool.com
ADMIN_PASSWORD=Admin@123456

# Production SSH deployment
SSH_HOST=your.server.com
SSH_USER=deploy
DEPLOY_PATH=/opt/music-school
